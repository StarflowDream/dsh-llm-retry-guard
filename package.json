{
  "name": "dsh-llm-retry-guard",
  "version": "0.2.0",
  "description": "One malformed provider stream must not cost a whole turn: extra {kind:'retry'} recovery on DSH's agent/request-error waterfall for the failure codes the built-in policy never retries (MALFORMED_RESPONSE / STREAM_CLOSED / STREAM_CUT).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "malformed-response",
    "llm-stream",
    "resilience",
    "tool-call-json"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "license": "MIT",
  "author": "StarflowDream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarflowDream/dsh-llm-retry-guard.git"
  },
  "homepage": "https://github.com/StarflowDream/dsh-llm-retry-guard#readme",
  "bugs": {
    "url": "https://github.com/StarflowDream/dsh-llm-retry-guard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
